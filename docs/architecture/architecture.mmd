flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Client([HTTP client]):::edge
        CLI(["CLI<br/>benchmark, search, serve"]):::edge
        Router["Router<br/>/search, /recall"]:::edge
        Validate["Validation<br/>dim, k, ef bounds"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph State["Data and state"]
        direction TB
        Vectors[("Synthetic vectors<br/>clustered, seeded")]:::data
        Graph[("Layered graph<br/>M edges per node")]:::data
        Brute[("BruteForce index<br/>exact ground truth")]:::data
        Metric["Distance metric<br/>Euclidean or cosine"]:::control
        Vectors --> Graph
        RustCore[["Rust core (optional)<br/>same graph, batch search"]]:::core
        Brute ~~~ Metric ~~~ RustCore
    end

    subgraph Core["HNSW index"]
        direction TB
        Insert["Insert<br/>geometric level"]:::core
        Select["Neighbor heuristic<br/>prune to M or 2M"]:::control
        Greedy["Greedy descent<br/>upper layers"]:::core
        Beam["Beam search<br/>bottom layer, ef"]:::core
        TopK["Top-k by distance"]:::core
        Insert --> Select ~~~ Greedy --> Beam --> TopK
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Counter["DistanceCounter<br/>per query"]:::obs
        Recall["Recall@k report<br/>recall, speedup"]:::obs
        Compare["Cross-library run<br/>hnswlib, FAISS"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus"]:::obs
        Recall ~~~ Counter ~~~ Compare ~~~ Metrics
    end

    Interfaces -->|vector, k, ef| Core
    State -.->|vectors, graph, Rust backend| Core
    Core -->|ids + distances| Obs
